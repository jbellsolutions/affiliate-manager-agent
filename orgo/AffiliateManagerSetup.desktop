[Desktop Entry]
Type=Application
Name=Connect Affiliate Manager
Comment=Connect messaging and approved business tools
Exec=xfce4-terminal --title="Affiliate Manager Setup" --command="bash -lc 'cd /opt/affiliate-manager-agent 2>/dev/null || cd $HOME/affiliate-manager-agent; ./orgo/connect.sh; exec bash'"
